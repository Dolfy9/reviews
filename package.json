{
  "name": "product-reviews-platform",
  "version": "0.0.1",
  "private": true,
  "description": "Full-stack product review system with TypeScript, NestJS, React, Vite, PostgreSQL+pgvector, and Docker.",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "prod": "node scripts/start.mjs prod",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml --env-file .env up --build",
    "docker:dev:detach": "docker compose -f docker/docker-compose.dev.yml --env-file .env up --build -d",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml --env-file .env up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml -f docker/docker-compose.prod.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "db:migrate": "docker compose -f docker/docker-compose.dev.yml exec api pnpm --filter @product-reviews/api exec prisma migrate deploy",
    "db:studio": "docker compose -f docker/docker-compose.dev.yml exec api pnpm --filter @product-reviews/api exec prisma studio",
    "db:seed": "docker compose -f docker/docker-compose.dev.yml exec api pnpm --filter @product-reviews/api exec tsx prisma/seed.ts",
    "db:reset": "pnpm docker:down -v && pnpm docker:dev:detach && pnpm db:migrate && pnpm db:seed",
    "dev:local": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "codemap": "tsx scripts/update-codemap.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
